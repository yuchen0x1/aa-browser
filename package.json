{
  "name": "aa-browser",
  "productName": "Aa Browser",
  "desktopName": "aa-browser.desktop",
  "version": "0.17.0",
  "description": "AI-native browser — browse like a human, drive like an agent (为 Agent 而生的浏览器)",
  "license": "MIT",
  "author": {
    "name": "Aa Browser contributors"
  },
  "main": "out/main/index.js",
  "bin": {
    "aa-browser-mcp": "cli/mcp.mjs"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/build-bridge.mjs && node packages/dsh/scripts/sync-bridge.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "check:tools": "node scripts/check-tools.mjs",
    "check:prompt": "node scripts/generate-prompt.mjs --check",
    "check:dsh": "node scripts/check-dsh-plugin.mjs",
    "check:readme-i18n": "node scripts/check-readme-i18n.mjs",
    "check:release-bodies": "node scripts/check-release-bodies.mjs",
    "check:release-bodies:remote": "node scripts/check-release-bodies.mjs --remote",
    "prompt": "node scripts/generate-prompt.mjs",
    "dsh:sync": "node packages/dsh/scripts/sync-bridge.mjs",
    "test:tools": "node scripts/test-tool-contract.mjs",
    "test:cloudflare": "node scripts/test-cloudflare.mjs",
    "test:page-scripts": "node scripts/test-page-scripts.mjs",
    "test:setup-jsonc": "node scripts/test-setup-jsonc.mjs",
    "test:tab-queue": "node scripts/test-tab-queue.mjs",
    "test:frame-elements": "node scripts/test-frame-elements.mjs",
    "test:evidence": "node scripts/test-evidence.mjs && node scripts/test-evidence-exports.mjs",
    "test:extensions": "node scripts/test-extensions.mjs",
    "test:extensions-e2e": "node scripts/test-extensions-e2e.mjs",
    "test:network-security": "node scripts/test-network-security.mjs",
    "test:github-release-download": "node scripts/test-github-release-download.mjs",
    "test:github-release-updater": "node scripts/test-github-release-updater.mjs",
    "test:sbom": "node scripts/test-sbom.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:tools && npm run check:prompt && npm run check:dsh && npm run test:cloudflare && npm run test:page-scripts && npm run test:atomic-json && npm run test:ref-lifecycle && npm run test:setup-jsonc && npm run test:tab-queue && npm run test:evidence && npm run test:extensions && npm run test:network-security && npm run test:github-release-download && npm run test:sbom && npm run check:readme-i18n && npm run check:release-bodies",
    "test:installer": "node scripts/test-installer.mjs",
    "test:bridge": "node scripts/test-bridge-offline.mjs",
    "test:bridge-connection-race": "node scripts/test-bridge-connection-race.mjs",
    "test:bridge-lifecycle": "node scripts/test-bridge-lifecycle.mjs && node scripts/test-bridge-autolaunch-paths.mjs",
    "test:bridge-restart-replay": "node scripts/test-bridge-restart-replay.mjs",
    "test:agent-cancellation": "node scripts/test-agent-cancellation.mjs",
    "test:atomic-json": "node scripts/test-atomic-json.mjs",
    "test:task-center": "node --experimental-strip-types scripts/test-task-center.mjs",
    "test:ref-lifecycle": "node scripts/test-ref-lifecycle.mjs",
    "test:renderer-crash": "node scripts/test-renderer-crash.mjs",
    "measure:runtime-costs": "node scripts/measure-runtime-costs.mjs",
    "test:session-permissions": "node scripts/test-session-permissions.mjs",
    "test:approval-parity": "node scripts/test-tools-approval-runtime.mjs",
    "test:bridge-autolaunch": "node scripts/test-bridge-autolaunch.mjs",
    "test:connect": "node scripts/test-connect-flow.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:background": "node scripts/test-background.mjs",
    "test:ui-ux": "node scripts/test-ui-ux.mjs",
    "test:settings-safety": "node scripts/test-settings-safety.mjs",
    "test:cancel-side-effects": "node scripts/test-cancel-side-effects.mjs",
    "test:newtab-i18n": "node scripts/test-newtab-i18n.mjs",
    "test:app-i18n": "node scripts/test-app-i18n.mjs",
    "test:main-diagnostics": "node scripts/test-main-diagnostics.mjs",
    "test:client-config": "node scripts/test-client-config.mjs",
    "test:printing": "node scripts/test-printing.mjs",
    "test:display-matrix": "node scripts/test-display-matrix.mjs",
    "test:update-ui": "node scripts/test-desktop.mjs --update-ui",
    "test:stores": "node scripts/test-stores.mjs",
    "test:security": "node scripts/test-security.mjs",
    "test:updater": "node scripts/test-updater.mjs",
    "test:update-restart": "node scripts/test-update-restart.mjs",
    "test:release": "node scripts/test-release.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "validate:workbuddy": "node scripts/validate-workbuddy.mjs",
    "validate:codex": "node scripts/validate-codex-setup.mjs",
    "validate:opencode": "node scripts/validate-opencode-setup.mjs",
    "icon": "electron scripts/make-icon.js",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "ai",
    "agent",
    "browser",
    "mcp",
    "electron",
    "browser-automation"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "js-yaml": "^4.3.2",
    "rolldown": "^1.2.16",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1",
    "ws": "^8.23.0"
  },
  "overrides": {
    "minimatch@^9": "^11.0.4",
    "minimatch@^10": "^11.0.4"
  }
}
