{
  "name": "aa-browser",
  "productName": "Aa Browser",
  "version": "0.6.3",
  "description": "AI-native browser — browse like a human, drive like an agent (为 Agent 而生的浏览器)",
  "license": "MIT",
  "author": {
    "name": "Aa Browser contributors"
  },
  "main": "out/main/index.js",
  "bin": {
    "aa-browser-mcp": "cli/mcp.mjs"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/build-bridge.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "check:tools": "node scripts/check-tools.mjs",
    "check": "npm run typecheck && npm run check:tools",
    "smoke": "node scripts/smoke.mjs",
    "validate:workbuddy": "node scripts/validate-workbuddy.mjs",
    "validate:codex": "node scripts/validate-codex-setup.mjs",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-vite build && node scripts/build-bridge.mjs && electron-builder --win"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "agent",
    "browser",
    "mcp",
    "electron",
    "browser-automation"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ws": "^8.22.1"
  },
  "overrides": {
    "minimatch@^9": "^11.0.4",
    "minimatch@^10": "^11.0.4"
  }
}
